{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=CardUsageGuardDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Authentication": {
    "Google": {
      "ClientId": "PLACEHOLDER_CLIENT_ID",
      "ClientSecret": "PLACEHOLDER_CLIENT_SECRET"
    }
  },
  "ProviderApi": {
    "Visa": {
      "Url": "https://api.visa-placeholder.com/v1/cards/status",
      "Method": "POST"
    },
    "Mastercard": {
      "Url": "https://api.mastercard-placeholder.com/v1/cards/status",
      "Method": "POST"
    },
    "Amex": {
      "Url": "https://api.amex-placeholder.com/v1/cards/status",
      "Method": "POST"
    },
    "Other": {
      "Url": "https://api.generic-placeholder.com/v1/cards/status",
      "Method": "POST"
    }
  },
  "Otp": {
    "CodeLength": 6,
    "ExpiryMinutes": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}