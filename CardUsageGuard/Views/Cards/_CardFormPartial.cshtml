@model CardViewModel
@{
    Layout = null;
}
<form id="cardForm" asp-action="@(Model.Id > 0 ? "Edit" : "Create")" asp-route-id="@(Model.Id > 0 ? Model.Id : null)" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display:none;"></div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-group mb-3">
                <label asp-for="CardName" class="form-label">Card Name <span class="text-danger">*</span></label>
                <input asp-for="CardName" class="form-control" placeholder="e.g. Daily Spending" />
                <span asp-validation-for="CardName" class="text-danger small"></span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group mb-3">
                <label asp-for="CardProvider" class="form-label">Card Provider <span class="text-danger">*</span></label>
                <select asp-for="CardProvider" asp-items="Html.GetEnumSelectList<CardProvider>()" class="form-control"></select>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-group mb-3">
                <label asp-for="CardType" class="form-label">Card Type <span class="text-danger">*</span></label>
                <select asp-for="CardType" asp-items="Html.GetEnumSelectList<CardType>()" class="form-control"></select>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group mb-3">
                <label asp-for="ExpirationDate" class="form-label">Expiration Date <span class="text-danger">*</span></label>
                <input asp-for="ExpirationDate" type="date" class="form-control" value="@(Model.ExpirationDate != DateTime.MinValue ? Model.ExpirationDate.ToString("yyyy-MM-dd") : "")" />
                <span asp-validation-for="ExpirationDate" class="text-danger small"></span>
            </div>
        </div>
    </div>
    <div class="form-group mb-3">
        <label asp-for="CardNumber" class="form-label">Card Number <span class="text-danger">*</span> @if (Model.Id > 0) { <span class="text-muted small">(last 4 digits stored — not editable)</span> }</label>
        @if (Model.Id > 0)
        {
            <input type="hidden" asp-for="CardNumber" />
            <input class="form-control font-mono" value="**** **** **** @Model.CardNumber" readonly disabled />
            <small class="text-muted">For security, only the last 4 digits are stored and cannot be changed.</small>
        }
        else
        {
            <input asp-for="CardNumber" class="form-control font-mono" placeholder="0000 0000 0000 0000" />
            <span asp-validation-for="CardNumber" class="text-danger small"></span>
            <small class="text-muted">Enter the full card number. Only the last 4 digits will be saved.</small>
        }
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-group mb-3">
                <label asp-for="PhoneNumber" class="form-label">Phone Number <span class="text-danger">*</span></label>
                <input asp-for="PhoneNumber" class="form-control" placeholder="+1 555 000 0000" />
                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                <small class="text-muted">Used to send verification codes.</small>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group mb-3">
                <label asp-for="Email" class="form-label">Email <span class="text-danger">*</span></label>
                <input asp-for="Email" class="form-control" placeholder="user@email.com" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
        </div>
    </div>
    <div class="form-group mb-3">
        <label asp-for="Status" class="form-label">Initial Card Status</label>
        <select asp-for="Status" asp-items="Html.GetEnumSelectList<CardStatus>()" class="form-control"></select>
        <small class="text-muted">Set whether the card starts enabled or disabled. You can change this later via Manage Cards.</small>
    </div>
    <div class="d-flex gap-2 mt-4">
        <button type="button" class="btn btn-outline-secondary flex-grow-1" data-bs-dismiss="modal">
            <i class="bi bi-x-circle me-1"></i> Cancel
        </button>
        <button type="submit" class="btn btn-primary flex-grow-1">
            <i class="bi bi-check-circle me-1"></i> @(Model.Id > 0 ? "Save Changes" : "Add Card")
        </button>
    </div>
</form>
