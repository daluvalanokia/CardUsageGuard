@model LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Login";
}
<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - CardUsageGuard</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/dark-theme.css" />
</head>
<body class="dark-theme auth-page">
    <div class="auth-container">
        <div class="auth-card">
            <div class="auth-header">
                <i class="bi bi-shield-lock-fill"></i>
                <h1>Welcome back</h1>
                <p>Log in to your account</p>
            </div>

            <div class="alert alert-danger" asp-validation-summary="ModelOnly"></div>

            <form asp-action="Login" method="post">
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                <div class="form-group">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" class="form-control" placeholder="you@example.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Password" class="form-label">Password</label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="Password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="form-check">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label">Remember me?</label>
                </div>
                <button type="submit" class="btn btn-primary w-100 mt-3">Log In</button>
            </form>

            <div class="divider"><span>or</span></div>

            <a asp-controller="Account" asp-action="ExternalLogin" asp-route-provider="Google" asp-route-returnUrl="@ViewData["ReturnUrl"]"
               class="btn btn-outline-light w-100">
                <i class="bi bi-google"></i> Continue with Google
            </a>

            <p class="auth-footer">
                Don't have an account? <a asp-action="Register">Create one</a>
            </p>
            <p><a asp-action="ForgotPassword">Forgot password?</a></p>
        </div>
    </div>
</body>
</html>