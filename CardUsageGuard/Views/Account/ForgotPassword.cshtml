@{
    Layout = null;
    ViewData["Title"] = "Forgot Password";
}
<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="utf-8" />
    <title>Forgot Password - CardUsageGuard</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/dark-theme.css" />
</head>
<body class="dark-theme auth-page">
    <div class="auth-container">
        <div class="auth-card">
            <h1>Forgot Password</h1>
            @if (TempData["ResetLink"] != null)
            {
                <div class="alert alert-info">
                    <p>Dev reset link (in production this would be emailed):</p>
                    <a href="@TempData["ResetLink"]">@TempData["ResetLink"]</a>
                </div>
            }
            <form asp-action="ForgotPassword" method="post">
                <div class="form-group">
                    <label>Email</label>
                    <input name="email" type="email" class="form-control" required />
                </div>
                <button type="submit" class="btn btn-primary w-100 mt-3">Send Reset Link</button>
            </form>
            <p class="auth-footer"><a asp-action="Login">Back to login</a></p>
        </div>
    </div>
</body>
</html>