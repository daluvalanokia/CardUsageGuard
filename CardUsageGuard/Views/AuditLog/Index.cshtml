@model List<AuditLogViewModel>
@using CardUsageGuard.Models.Enums
@{
    ViewData["Title"] = "Audit Log";
    var isAdmin = ViewBag.IsAdmin as bool? ?? false;
}

<style>
    .sortable-header { white-space: nowrap; user-select: none; }
    .sortable-header:hover { background: rgba(255, 255, 255, 0.05); color: var(--accent-blue) !important; }
    .filter-section {
        background: var(--bg-secondary);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-sm);
    }
    .audit-count-badge {
        background: var(--bg-secondary); border: 1px solid var(--border-color);
        border-radius: 20px; padding: 4px 14px; font-size: 0.85rem; color: var(--text-muted);
    }
    .audit-row td { vertical-align: top; }

    /* Payload expand/collapse */
    .payload-cell { max-width: 250px; }
    .payload-toggle {
        cursor: pointer;
        color: var(--accent-blue);
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 8px;
        border-radius: 4px;
        transition: all 0.15s;
    }
    .payload-toggle:hover {
        background: rgba(59, 130, 246, 0.12);
        text-decoration: underline;
    }
    .payload-full {
        display: none;
        word-break: break-all;
        white-space: pre-wrap;
        font-family: "SF Mono", Monaco, Consolas, monospace;
        font-size: 11px;
        line-height: 1.5;
        max-height: 300px;
        overflow-y: auto;
    }
    .payload-expanded .payload-full { display: block; }
    .payload-expanded .payload-preview { display: none; }
    .payload-preview {
        font-family: "SF Mono", Monaco, Consolas, monospace;
        font-size: 11px;
        color: var(--text-muted);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        max-width: 230px;
        padding: 2px 0;
    }
    .payload-block {
        background: var(--bg-primary);
        border: 1px solid var(--border-color);
        border-radius: 6px;
        padding: 10px 12px;
        margin-bottom: 8px;
    }
    .payload-label {
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 4px;
        display: block;
    }
    .payload-label.req { color: #60A5FA; }
    .payload-label.res { color: #34D399; }
    .payload-label.url { color: var(--text-muted); }
    .payload-code {
        color: var(--text-primary);
        word-break: break-all;
        white-space: pre-wrap;
    }
</style>

<div class="page-header">
    <div>
        <h1>Audit Log</h1>
        <p class="text-muted">Full audit trail of all sensitive operations @(isAdmin ? "— including API request/response payloads" : "")</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="audit-count-badge">@Model.Count entries</span>
        <button onclick="window.location.href = window.location.href" class="btn btn-icon" title="Refresh audit logs">
            <i class="bi bi-arrow-clockwise"></i>
        </button>
    </div>
</div>

<!-- Filter Controls -->
<div class="filter-section p-3 mb-4">
    <div class="row g-3">
        <div class="col-md-4">
            <label for="logSearch" class="form-label">Search Logs</label>
            <div class="input-group">
                <span class="input-group-text bg-card border-color text-muted"><i class="bi bi-search"></i></span>
                <input type="text" id="logSearch" onkeyup="filterLogs()" class="form-control" placeholder="Search by Card ID, action, error, URL..." />
            </div>
        </div>
        <div class="col-md-2">
            <label for="logActionFilter" class="form-label">Action</label>
            <select id="logActionFilter" onchange="filterLogs()" class="form-select">
                <option value="">All Actions</option>
                @foreach (var action in Enum.GetValues<AuditActionType>())
                {
                    <option value="@action">@action</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label for="logProviderFilter" class="form-label">Provider</label>
            <select id="logProviderFilter" onchange="filterLogs()" class="form-select">
                <option value="">All Providers</option>
                @foreach (var provider in Enum.GetValues<CardProvider>())
                {
                    <option value="@provider">@provider</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label for="logSuccessFilter" class="form-label">Status</label>
            <select id="logSuccessFilter" onchange="filterLogs()" class="form-select">
                <option value="">All Statuses</option>
                <option value="true">Success</option>
                <option value="false">Failed</option>
            </select>
        </div>
        <div class="col-md-2 d-flex align-items-end">
            <button onclick="clearFilters()" class="btn btn-outline-secondary w-100">
                <i class="bi bi-x-circle"></i> Clear Filters
            </button>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <i class="bi bi-list-check"></i>
        <h3>No audit entries yet</h3>
        <p>Audit logs will appear here as you perform card operations.</p>
    </div>
}
else
{
    <div class="audit-table-container">
        <table class="table audit-table" id="logsTable">
            <thead>
                <tr>
                    <th onclick="sortTable('logsTable', 0, 'date')" style="cursor: pointer;" class="sortable-header">
                        Timestamp <i class="bi bi-arrow-down-up bi-sort-indicator text-muted ms-1"></i>
                    </th>
                    <th onclick="sortTable('logsTable', 1, 'string')" style="cursor: pointer;" class="sortable-header">
                        Action <i class="bi bi-arrow-down-up bi-sort-indicator text-muted ms-1"></i>
                    </th>
                    <th onclick="sortTable('logsTable', 2, 'string')" style="cursor: pointer;" class="sortable-header">
                        Provider <i class="bi bi-arrow-down-up bi-sort-indicator text-muted ms-1"></i>
                    </th>
                    <th onclick="sortTable('logsTable', 3, 'string')" style="cursor: pointer;" class="sortable-header">
                        HTTP <i class="bi bi-arrow-down-up bi-sort-indicator text-muted ms-1"></i>
                    </th>
                    <th onclick="sortTable('logsTable', 4, 'string')" style="cursor: pointer;" class="sortable-header">
                        Status <i class="bi bi-arrow-down-up bi-sort-indicator text-muted ms-1"></i>
                    </th>
                    <th onclick="sortTable('logsTable', 5, 'string')" style="cursor: pointer;" class="sortable-header">
                        Card ID <i class="bi bi-arrow-down-up bi-sort-indicator text-muted ms-1"></i>
                    </th>
                    <th onclick="sortTable('logsTable', 6, 'string')" style="cursor: pointer;" class="sortable-header">
                        Error <i class="bi bi-arrow-down-up bi-sort-indicator text-muted ms-1"></i>
                    </th>
                    <th onclick="sortTable('logsTable', 7, 'number')" style="cursor: pointer;" class="sortable-header">
                        Duration <i class="bi bi-arrow-down-up bi-sort-indicator text-muted ms-1"></i>
                    </th>
                    @if (isAdmin)
                    {
                        <th>API Request / Response</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model)
                {
                    <tr class="audit-row audit-@(log.Success ? "success" : "fail")" 
                        data-action="@log.ActionType" 
                        data-provider="@(log.Provider ?? "")" 
                        data-success="@log.Success.ToString().ToLower()">
                        <td class="font-mono" data-sort="@log.Timestamp.ToString("yyyy-MM-ddTHH:mm:ss")">
                            @log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")
                        </td>
                        <td><span class="badge badge-action">@log.ActionType</span></td>
                        <td>@(log.Provider ?? "—")</td>
                        <td>
                            @if (!string.IsNullOrEmpty(log.HttpMethod))
                            {
                                <span class="font-mono small">@log.HttpMethod</span>
                                @if (log.HttpStatusCode.HasValue)
                                {
                                    <br /><span class="small @(log.HttpStatusCode >= 200 && log.HttpStatusCode < 300 ? "text-success" : "text-danger")">@log.HttpStatusCode</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td data-sort="@log.Success.ToString().ToLower()">
                            @if (log.Success)
                            {
                                <span class="text-success"><i class="bi bi-check-circle-fill"></i> Success</span>
                            }
                            else
                            {
                                <span class="text-danger"><i class="bi bi-x-circle-fill"></i> Failed</span>
                            }
                        </td>
                        <td class="font-mono">@log.CardIdMasked</td>
                        <td>
                            @if (!string.IsNullOrEmpty(log.ErrorMessage))
                            {
                                <span class="text-danger small" title="@log.ErrorMessage">@log.ErrorCode</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td data-sort="@log.DurationMs">@(log.DurationMs)ms</td>
                        @if (isAdmin)
                        {
                            <td class="payload-cell">
                                @if (!string.IsNullOrEmpty(log.RequestPayload) || !string.IsNullOrEmpty(log.ResponsePayload))
                                {
                                    <!-- Collapsed preview -->
                                    <div class="payload-preview">@(log.RequestPayload ?? "—")</div>
                                    
                                    <!-- Expanded view -->
                                    <div class="payload-full">
                                        @if (!string.IsNullOrEmpty(log.HttpUrl))
                                        {
                                            <div class="payload-block">
                                                <span class="payload-label url">Endpoint URL</span>
                                                <code class="payload-code text-info">@log.HttpUrl</code>
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(log.HttpMethod))
                                        {
                                            <div class="payload-block">
                                                <span class="payload-label url">HTTP Method & Status</span>
                                                <code class="payload-code">@log.HttpMethod → @(log.HttpStatusCode?.ToString() ?? "N/A")</code>
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(log.RequestPayload))
                                        {
                                            <div class="payload-block">
                                                <span class="payload-label req"><i class="bi bi-arrow-up-circle"></i> Request Sent</span>
                                                <code class="payload-code">@log.RequestPayload</code>
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(log.ResponsePayload))
                                        {
                                            <div class="payload-block">
                                                <span class="payload-label res"><i class="bi bi-arrow-down-circle"></i> Response Received</span>
                                                <code class="payload-code">@log.ResponsePayload</code>
                                            </div>
                                        }
                                    </div>
                                    
                                    <span class="payload-toggle" onclick="togglePayload(this)">
                                        <i class="bi bi-zoom-in"></i> Show API details
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
<script>
    function togglePayload(el) {
        const cell = el.closest('.payload-cell');
        cell.classList.toggle('payload-expanded');
        if (cell.classList.contains('payload-expanded')) {
            el.innerHTML = '<i class="bi bi-zoom-out"></i> Hide API details';
        } else {
            el.innerHTML = '<i class="bi bi-zoom-in"></i> Show API details';
        }
    }

    function filterLogs() {
        const searchText = document.getElementById('logSearch').value.toLowerCase();
        const actionFilter = document.getElementById('logActionFilter').value;
        const providerFilter = document.getElementById('logProviderFilter').value;
        const successFilter = document.getElementById('logSuccessFilter').value;

        const rows = document.querySelectorAll('#logsTable tbody tr');
        let visibleCount = 0;

        rows.forEach(row => {
            const text = row.textContent.toLowerCase();
            const action = row.getAttribute('data-action') || '';
            const provider = row.getAttribute('data-provider') || '';
            const success = row.getAttribute('data-success') || '';

            const matchesSearch = !searchText || text.includes(searchText);
            const matchesAction = !actionFilter || action === actionFilter;
            const matchesProvider = !providerFilter || provider === providerFilter;
            const matchesSuccess = !successFilter || success === successFilter;

            if (matchesSearch && matchesAction && matchesProvider && matchesSuccess) {
                row.style.display = '';
                visibleCount++;
            } else {
                row.style.display = 'none';
            }
        });

        const container = document.querySelector('.audit-table-container');
        let noLogsMsg = document.getElementById('noLogsFilteredMessage');
        if (visibleCount === 0 && rows.length > 0) {
            if (!noLogsMsg) {
                noLogsMsg = document.createElement('div');
                noLogsMsg.id = 'noLogsFilteredMessage';
                noLogsMsg.className = 'text-center py-4 text-muted';
                noLogsMsg.innerHTML = '<i class="bi bi-search d-block fs-3 mb-2"></i> No matching logs found';
                container.appendChild(noLogsMsg);
            } else {
                noLogsMsg.style.display = 'block';
            }
        } else if (noLogsMsg) {
            noLogsMsg.style.display = 'none';
        }
    }

    function clearFilters() {
        document.getElementById('logSearch').value = '';
        document.getElementById('logActionFilter').value = '';
        document.getElementById('logProviderFilter').value = '';
        document.getElementById('logSuccessFilter').value = '';
        filterLogs();
    }

    function sortTable(tableId, colIndex, type) {
        const table = document.getElementById(tableId);
        const tbody = table.querySelector('tbody');
        if (!tbody) return;
        const rows = Array.from(tbody.querySelectorAll('tr'));
        if (rows.length === 0) return;

        let isAsc = true;
        const header = table.querySelectorAll('thead th')[colIndex];
        if (header.classList.contains('sort-asc')) {
            isAsc = false;
            header.classList.remove('sort-asc');
            header.classList.add('sort-desc');
        } else {
            table.querySelectorAll('thead th').forEach(th => {
                th.classList.remove('sort-asc', 'sort-desc');
                const icon = th.querySelector('.bi-sort-indicator');
                if (icon) icon.className = 'bi bi-arrow-down-up bi-sort-indicator text-muted ms-1';
            });
            header.classList.add('sort-asc');
        }

        const icon = header.querySelector('.bi-sort-indicator');
        if (icon) {
            icon.className = isAsc ? 'bi bi-arrow-up bi-sort-indicator text-primary ms-1' : 'bi bi-arrow-down bi-sort-indicator text-primary ms-1';
        }

        rows.sort((rowA, rowB) => {
            const cellA = rowA.cells[colIndex];
            const cellB = rowB.cells[colIndex];
            let valA = cellA.getAttribute('data-sort') || cellA.textContent.trim();
            let valB = cellB.getAttribute('data-sort') || cellB.textContent.trim();

            if (type === 'number') {
                return isAsc ? Number(valA) - Number(valB) : Number(valB) - Number(valA);
            } else if (type === 'date') {
                return isAsc ? new Date(valA) - new Date(valB) : new Date(valB) - new Date(valA);
            } else {
                return isAsc ? valA.localeCompare(valB) : valB.localeCompare(valA);
            }
        });

        rows.forEach(row => tbody.appendChild(row));
    }
</script>
}
