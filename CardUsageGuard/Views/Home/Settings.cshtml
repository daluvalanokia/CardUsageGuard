@using CardUsageGuard.Models.ViewModels
@using CardUsageGuard.Models.Enums
@{
    var cards = ViewBag.Cards as List<CardViewModel> ?? new List<CardViewModel>();
    ViewData["Title"] = "Settings";
}

<style>
    .sortable-header {
        white-space: nowrap;
        user-select: none;
    }
    .sortable-header:hover {
        background: rgba(255, 255, 255, 0.05);
        color: var(--accent-blue) !important;
    }
    .action-btn {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 500;
        border: 1px solid transparent;
        transition: all 0.15s ease;
        cursor: pointer;
        background: transparent;
    }
    .action-btn.edit-btn {
        color: #60a5fa;
        border-color: rgba(96, 165, 250, 0.3);
    }
    .action-btn.edit-btn:hover {
        background: rgba(96, 165, 250, 0.12);
        border-color: #60a5fa;
    }
    .action-btn.delete-btn {
        color: #f87171;
        border-color: rgba(248, 113, 113, 0.3);
    }
    .action-btn.delete-btn:hover {
        background: rgba(248, 113, 113, 0.12);
        border-color: #f87171;
    }
</style>

@Html.AntiForgeryToken()

<div class="page-header">
    <div>
        <h1>Settings</h1>
        <p class="text-muted">Manage your saved cards — add, edit, or remove</p>
    </div>
    <div class="d-flex gap-2">
        <button onclick="location.reload()" class="btn btn-icon" title="Refresh card list">
            <i class="bi bi-arrow-clockwise"></i> Refresh
        </button>
        <button onclick="addCard()" class="btn btn-primary" title="Add a new card">
            <i class="bi bi-plus-circle me-1"></i> Add Card
        </button>
    </div>
</div>

<div class="cards-section">
    @if (!cards.Any())
    {
        <div class="empty-state">
            <i class="bi bi-credit-card"></i>
            <h3>No cards found</h3>
            <p class="text-muted">You haven't added any cards yet. Click "Add Card" to get started.</p>
        </div>
    }
    else
    {
        <div class="card-table-container">
            <table class="table card-table" id="cardsTable">
                <thead>
                    <tr>
                        <th onclick="sortTable('cardsTable', 0, 'string')" style="cursor: pointer;" class="sortable-header">
                            Card Name <i class="bi bi-arrow-down-up bi-sort-indicator text-muted ms-1"></i>
                        </th>
                        <th onclick="sortTable('cardsTable', 1, 'string')" style="cursor: pointer;" class="sortable-header">
                            Provider <i class="bi bi-arrow-down-up bi-sort-indicator text-muted ms-1"></i>
                        </th>
                        <th onclick="sortTable('cardsTable', 2, 'string')" style="cursor: pointer;" class="sortable-header">
                            Type <i class="bi bi-arrow-down-up bi-sort-indicator text-muted ms-1"></i>
                        </th>
                        <th>Card Number</th>
                        <th onclick="sortTable('cardsTable', 4, 'date')" style="cursor: pointer;" class="sortable-header">
                            Expiration <i class="bi bi-arrow-down-up bi-sort-indicator text-muted ms-1"></i>
                        </th>
                        <th onclick="sortTable('cardsTable', 5, 'string')" style="cursor: pointer;" class="sortable-header">
                            Status <i class="bi bi-arrow-down-up bi-sort-indicator text-muted ms-1"></i>
                        </th>
                        <th>Phone</th>
                        <th>Email</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var card in cards)
                    {
                        <tr id="card-row-@card.Id" class="@(card.Status == CardStatus.Disabled ? "row-disabled" : "")">
                            <td><strong>@card.CardName</strong></td>
                            <td><span class="badge badge-@card.CardProvider.ToString().ToLower()">@card.CardProvider</span></td>
                            <td>@card.CardType</td>
                            <td class="font-mono">@card.MaskedCardNumber</td>
                            <td data-sort="@card.ExpirationDate.ToString("yyyy-MM-dd")">@card.ExpirationDate.ToString("MM/yy")</td>
                            <td>
                                <span class="status-badge status-@card.Status.ToString().ToLower()">
                                    <i class="bi @(card.Status == CardStatus.Enabled ? "bi-check-circle-fill" : "bi-x-circle-fill")"></i>
                                    @card.Status
                                </span>
                            </td>
                            <td>@card.PhoneNumber</td>
                            <td>@card.Email</td>
                            <td class="actions">
                                <button class="action-btn edit-btn" onclick="editCard(@card.Id)" title="Edit card details">
                                    <i class="bi bi-pencil"></i> Edit
                                </button>
                                <button class="action-btn delete-btn" onclick="deleteCard(@card.Id, '@card.CardName')" title="Delete this card">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Card Form Modal -->
<div class="modal fade" id="cardFormModal" tabindex="-1" aria-labelledby="cardFormTitle" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="cardFormTitle">Add New Card</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="cardFormBody">
                <!-- Filled by partial view -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

    function addCard() {
        fetch('@Url.Action("Create", "Cards")', { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(r => r.text())
            .then(html => {
                document.getElementById('cardFormTitle').textContent = 'Add New Card';
                document.getElementById('cardFormBody').innerHTML = html;
                $.validator.unobtrusive.parse('#cardFormBody');
                new bootstrap.Modal(document.getElementById('cardFormModal')).show();
            });
    }

    function editCard(id) {
        fetch('@Url.Action("Edit", "Cards")/' + id, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(r => r.text())
            .then(html => {
                document.getElementById('cardFormTitle').textContent = 'Edit Card';
                document.getElementById('cardFormBody').innerHTML = html;
                $.validator.unobtrusive.parse('#cardFormBody');
                new bootstrap.Modal(document.getElementById('cardFormModal')).show();
            });
    }

    function deleteCard(id, name) {
        if (!confirm('Are you sure you want to delete "' + name + '"? This action cannot be undone.')) return;
        const form = new FormData();
        form.append('__RequestVerificationToken', antiForgeryToken);
        fetch('@Url.Action("Delete", "Cards")/' + id, { method: 'POST', body: form })
            .then(r => r.json())
            .then(data => { 
                if (data.success) {
                    location.reload(); 
                } else {
                    alert(data.error || 'Failed to delete card. Please try again.'); 
                }
            });
    }

    // Client-side table row sorting
    function sortTable(tableId, colIndex, type) {
        const table = document.getElementById(tableId);
        const tbody = table.querySelector('tbody');
        if (!tbody) return;
        const rows = Array.from(tbody.querySelectorAll('tr'));
        if (rows.length === 0) return;
        
        let isAsc = true;
        const header = table.querySelectorAll('thead th')[colIndex];
        if (header.classList.contains('sort-asc')) {
            isAsc = false;
            header.classList.remove('sort-asc');
            header.classList.add('sort-desc');
        } else {
            table.querySelectorAll('thead th').forEach(th => {
                th.classList.remove('sort-asc', 'sort-desc');
                const icon = th.querySelector('.bi-sort-indicator');
                if (icon) icon.className = 'bi bi-arrow-down-up bi-sort-indicator text-muted ms-1';
            });
            header.classList.add('sort-asc');
        }

        const icon = header.querySelector('.bi-sort-indicator');
        if (icon) {
            icon.className = isAsc ? 'bi bi-arrow-up bi-sort-indicator text-primary ms-1' : 'bi bi-arrow-down bi-sort-indicator text-primary ms-1';
        }

        rows.sort((rowA, rowB) => {
            const cellA = rowA.cells[colIndex];
            const cellB = rowB.cells[colIndex];
            let valA = cellA.getAttribute('data-sort') || cellA.textContent.trim();
            let valB = cellB.getAttribute('data-sort') || cellB.textContent.trim();

            if (type === 'number') {
                return isAsc ? Number(valA) - Number(valB) : Number(valB) - Number(valA);
            } else if (type === 'date') {
                return isAsc ? new Date(valA) - new Date(valB) : new Date(valB) - new Date(valA);
            } else {
                return isAsc ? valA.localeCompare(valB) : valB.localeCompare(valA);
            }
        });

        rows.forEach(row => tbody.appendChild(row));
    }

    // Intercept form submit inside the modal — send via AJAX
    document.addEventListener('submit', function (e) {
        if (e.target && e.target.id === 'cardForm') {
            e.preventDefault();
            const form = e.target;
            const url = form.getAttribute('action');
            const formData = new FormData(form);

            fetch(url, {
                method: 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(response => {
                const contentType = response.headers.get('content-type');
                if (contentType && contentType.indexOf('application/json') !== -1) {
                    return response.json().then(data => {
                        if (data.success) {
                            const modalEl = document.getElementById('cardFormModal');
                            const modalInstance = bootstrap.Modal.getInstance(modalEl);
                            if (modalInstance) {
                                modalInstance.hide();
                            }
                            location.reload();
                        } else {
                            alert(data.error || 'Failed to save card. Please check your inputs and try again.');
                        }
                    });
                } else {
                    // Server returned the partial with validation errors
                    return response.text().then(html => {
                        document.getElementById('cardFormBody').innerHTML = html;
                        $.validator.unobtrusive.parse('#cardFormBody');
                    });
                }
            })
            .catch(err => {
                console.error('Error submitting form:', err);
                alert('An error occurred while saving the card. Please try again.');
            });
        }
    });
</script>
}
