@{ ViewData["Title"] = "Settings"; }
<div class="page-header">
    <h1>Settings</h1>
    <p class="text-muted">Manage your account settings</p>
</div>
<div class="settings-container">
    <div class="settings-card">
        <h3>Profile</h3>
        <p>Update your account information.</p>
        <a href="@Url.Action("ForgotPassword", "Account")" class="btn btn-outline-primary">Change Password</a>
    </div>
    <div class="settings-card">
        <h3>Security</h3>
        <p>All card status changes require OTP verification.</p>
        <p class="text-muted">OTP expiry: 5 minutes | Code length: 6 digits</p>
    </div>
</div>